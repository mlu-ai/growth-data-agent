# Copy this file to .env and replace the values for your local setup.
# Never commit .env; it is ignored by git.
#
# POSTGRES_* are used by dbt. DATABASE_URL is used by the loader and API.
# Keep both configurations pointed at the same dedicated POC database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=growth_data_agent_poc
POSTGRES_USER=growth_data_agent_poc
POSTGRES_PASSWORD=replace-with-a-local-poc-password
DATABASE_URL=postgresql://growth_data_agent_poc:replace-with-a-local-poc-password@127.0.0.1:5432/growth_data_agent_poc
# Conversation checkpoints use this Postgres database by default. Set this
# separately when conversation storage should use another dedicated database.
# CONVERSATION_DATABASE_URL=postgresql://growth_data_agent_poc:replace-with-a-local-poc-password@127.0.0.1:5432/growth_data_agent_poc
# Raw turn metadata is retained for thirty days by default; active context is
# always bounded before it is supplied to a later turn.
# GROWTH_DATA_AGENT_CONVERSATION_RETENTION_DAYS=30

# Durable security decision records. The default is data/decision_records.sqlite3
# and the default retention is twelve months (365 days).
# GROWTH_DATA_AGENT_DECISION_RECORDS_PATH=data/decision_records.sqlite3
# GROWTH_DATA_AGENT_AUDIT_RETENTION_DAYS=365

# Development bearer credentials for the five local principals. Generate each
# value locally; never commit or log the token values.
# GROWTH_DATA_AGENT_DEV_TOKEN_DATA_ANALYST=
# GROWTH_DATA_AGENT_DEV_TOKEN_APAC_REGIONAL_MANAGER=
# GROWTH_DATA_AGENT_DEV_TOKEN_JIRA_PRODUCT_MANAGER=
# GROWTH_DATA_AGENT_DEV_TOKEN_CONFLUENCE_PRODUCT_MANAGER=
# GROWTH_DATA_AGENT_DEV_TOKEN_CUSTOMER_SUCCESS_MANAGER=

# Optional: set this when refreshing the Apache AGE evidence graph.
# APACHE_AGE_DATABASE_URL=postgresql://growth_data_agent_poc:replace-with-a-local-poc-password@127.0.0.1:5432/growth_data_agent_poc
# APACHE_AGE_GRAPH_NAME=growth_evidence

# External Qdrant is the production evidence index. The sync command requires
# QDRANT_URL; keep the API key in the local environment and never commit it.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=growth_evidence
